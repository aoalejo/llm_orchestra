# Credenciales del orquestador (copiar a .orchestra/.env — NO commitear)

# Cuenta A — reservada para el ORQUESTADOR (qwen3.8-max) y el juez/escalado.
OPENCODE_GO_KEY_ORCHESTRATOR=

# Cuentas B — workers y verifiers. UNA sola variable con una o más keys.
# Se usan de forma rotativa entre subagentes. Formatos aceptados:
#   OPENCODE_GO_KEYS=key1
#   OPENCODE_GO_KEYS=key1,key2,key3
#   OPENCODE_GO_KEYS=["key1","key2","key3"]
#   (también saltos de línea o punto y coma como separador)
OPENCODE_GO_KEYS=

# Si la cuenta de workers se agota, ¿permitimos usar la del orquestador? 1/0
ALLOW_WORKER_FALLBACK=0

# Ruta al cli de pi (opcional; se autodetecta).
ORCHESTRA_PI_CLI=

# Override del directorio de agentes (opcional).
ORCHESTRA_AGENTS_DIR=

# ── Legacy (opcional): una env var por cuenta. Sigue funcionando. ──
# config.keys.workers debe listar estos nombres, p.ej.:
#   "workers": ["OPENCODE_GO_KEY_WORKER_1", "OPENCODE_GO_KEY_WORKER_2"]
# OPENCODE_GO_KEY_WORKER_1=
# OPENCODE_GO_KEY_WORKER_2=
