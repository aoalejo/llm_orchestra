# Credenciales del orquestador (copiar a .orchestra/.env — NO commitear)

# Cuenta A — reservada para el ORQUESTADOR (qwen3.8-max) y el juez/escalado.
OPENCODE_GO_KEY_ORCHESTRATOR=

# Cuenta B — workers y verifiers (modelos baratos).
OPENCODE_GO_KEY_WORKER_1=

# Opcional: tercera cuenta para rotar entre workers.
OPENCODE_GO_KEY_WORKER_2=

# Si la cuenta de workers se agota, ¿permitimos usar la del orquestador? 1/0
ALLOW_WORKER_FALLBACK=0

# Ruta al cli de pi (opcional; se autodetecta).
ORCHESTRA_PI_CLI=

# Override del directorio de agentes (opcional).
ORCHESTRA_AGENTS_DIR=
