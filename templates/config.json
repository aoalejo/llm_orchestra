{
  "$comment": "Config del Lean Orchestrator v2. Ajustá 'gates' y 'protectedPaths' a tu proyecto. Las keys se pasan por invocacion con `pi --api-key` (prioridad 1 sobre auth.json/env).",
  "version": 2,
  "provider": "opencode-go",

  "keys": {
    "orchestrator": "OPENCODE_GO_KEY_ORCHESTRATOR",
    "workers": ["OPENCODE_GO_KEY_WORKER_1", "OPENCODE_GO_KEY_WORKER_2"]
  },

  "roles": {
    "orchestrator": { "model": "qwen3.8-max", "key": "orchestrator", "thinking": "high" },
    "judge": { "model": "qwen3.8-max", "key": "orchestrator", "thinking": "high" },
    "author": ["mimo-v2.6-flash", "deepseek-v4.1-flash", "qwen3.8-flash"],
    "verifier": ["deepseek-v4.1-flash", "qwen3.8-flash", "mimo-v2.6-flash"],
    "security": "qwen3.8-flash",
    "scout": "qwen3.8-flash",
    "scribe": "qwen3.8-flash",
    "merge": "deepseek-v4.1-flash",
    "escalationAuthor": "kimi-k2.7-code",
    "escalationVerifier": "deepseek-v4-pro"
  },

  "fallback": {
    "models": ["glm-5.3-flash", "deepseek-v4-flash", "minimax-m3"],
    "askOrchestratorOnExhaustion": true
  },

  "loop": {
    "maxCycles": 4,
    "maxParallelTasks": 4,
    "doubleVerifyHighRisk": true,
    "highRiskLevels": ["high", "critical"]
  },

  "worktrees": {
    "enabled": true,
    "dir": ".orchestra/worktrees",
    "linkNodeModules": true,
    "link": ["node_modules", "packages/*/node_modules", "apps/*/node_modules"]
  },

  "integration": {
    "strategy": "merge-branch",
    "branchPrefix": "orchestra/",
    "mergeAgent": true,
    "humanOnConflict": false
  },

  "scout": { "enabled": true },
  "metaReview": { "enabled": true, "sampleRate": 0.34, "alwaysForHighRisk": true },
  "progress": { "repeatSignatureLimit": 2 },

  "models": {
    "$comment": "Ranking de rotación: `orchestra models [--apply]` cruza catálogo opencode-go + arena.ai. workerMaxInputCost = tope USD/M input para entrar a la rotación.",
    "workerMaxInputCost": 0.5,
    "workersPerRole": 3,
    "fallbackCount": 3,
    "minContextWindow": 200000,
    "scoreTolerancePct": 0.01,
    "familyInference": true,
    "applyServiceRoles": true,
    "arenaUrl": "https://arena.ai/leaderboard/code/webdev",
    "aliases": {
      "$comment": "id de opencode-go -> slug(s) con los que figura en arena.ai.",
      "qwen3.8-flash": ["qwen3.8-flash-next", "qwen3.8-flash"]
    },
    "scoreOverrides": {
      "$comment": "Score fijado a mano para SKUs nuevos que arena aún no rankea. Revisar periódicamente y borrar cuando aparezcan en el leaderboard.",
      "mimo-v2.6-flash": { "score": 1616, "note": "SKU nuevo; ≈ deepseek-v4.1-flash según mantenedor (2026-09)" }
    },
    "rankings": { "enabled": true, "maxAgeDays": 7, "autoApply": true }
  },

  "budget": { "maxUsdPerTask": 2.0, "maxInputTokensPerTask": 4000000, "maxOutputTokensPerTask": 1000000 },

  "gates": {
    "$comment": "Comandos que se corren desde la raíz del proyecto (o el worktree). Reemplazá los targets por los de tu stack; cada tarea los referencia en 'targets'. Las claves que no son arrays ($comment, timeoutMs) se ignoran.",
    "timeoutMs": 1200000,
    "example": ["npm run lint", "npm run build", "npm test -- --run"]
  },

  "protectedPaths": [
    "migrations/",
    "src/auth/",
    "src/payments/"
  ],

  "commit": {
    "onlyOrchestrator": true,
    "convention": "conventional",
    "requireFlag": "--commit",
    "requireHumanApprovalForProtected": true
  },

  "piCli": ""
}
