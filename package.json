{
  "name": "llm-orchestra",
  "version": "0.3.0",
  "description": "Lean Orchestrator: Ralph loop multi-modelo con verificación adversa, worktrees y rotación de cuentas, para pi.",
  "type": "module",
  "bin": {
    "orchestra": "./orchestra.mjs"
  },
  "scripts": {
    "test": "node orchestra.mjs --self-test && node tests/smoke.mjs",
    "test:unit": "node orchestra.mjs --self-test",
    "test:smoke": "node tests/smoke.mjs"
  },
  "keywords": [
    "pi-package",
    "orchestrator",
    "multi-agent",
    "ralph-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoalejo/llm_orchestra.git"
  },
  "files": [
    "orchestra.mjs",
    "lib",
    "agents",
    "prompts",
    "templates",
    "extensions",
    "tests",
    "docs",
    "README.md",
    "AGENTS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
